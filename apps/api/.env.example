NODE_ENV=development
PORT=3000

# Local Postgres by default; swap for a free-tier managed Postgres (e.g. Neon,
# Railway) URL in other environments. See ARCHITECTURE.md §12.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lotea?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Two DIFFERENT secrets — never reuse one for both. Never commit real values.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Comma-separated browser origins allowed by CORS. Leave empty for a
# mobile-only API — see plugins/cors.ts and DATABASE.md.
CORS_ALLOWED_ORIGINS=
